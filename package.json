{
  "name": "dsh-memory-engine",
  "version": "0.8.3",
  "description": "DSH 本地记忆插件：自动记忆、遗忘曲线、关键词关联、可检索可编辑，数据留在本机。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "local-first",
    "memory-graph"
  ],
  "license": "MIT",
  "author": "dsh-memory-engine contributors",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-memory-map": "./scripts/render-map.mjs"
  },
  "files": [
    "lib/",
    "scripts/render-map.mjs",
    "scripts/sync-qq.mjs",
    "scripts/cleanup-imports.mjs",
    "scripts/build-client.mjs",
    "scripts/lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "bugs": {
    "url": "https://github.com/jiudouliang/dsh-memory-engine/issues"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiudouliang/dsh-memory-engine.git"
  },
  "homepage": "https://github.com/jiudouliang/dsh-memory-engine#readme"
}
